{
  "manifest_version": 2,
  "name": "Linear 中文翻译",
  "version": "1.3",
  "description": "用 DeepSeek 把 Linear ticket 翻译成中文，在弹窗中显示",
  "permissions": [
    "storage",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://linear.app/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "linear-translate@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}